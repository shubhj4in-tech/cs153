# ============================================================
# 4drecon environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── Weights & Biases ─────────────────────────────────────
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=4drecon
WANDB_ENTITY=your_wandb_username_here

# ── Hugging Face (for model downloads) ───────────────────
HF_TOKEN=your_hf_token_here

# ── Modal (auto-configured by `modal token new`) ─────────
# MODAL_TOKEN_ID=...
# MODAL_TOKEN_SECRET=...

# ── Local paths (override defaults) ─────────────────────
# MODELS_DIR=./models
# DATA_DIR=./data
# OUTPUT_DIR=./outputs

# ── CogVideoX model ID ───────────────────────────────────
COGVIDEOX_MODEL_ID=zai-org/CogVideoX-5b-I2V
